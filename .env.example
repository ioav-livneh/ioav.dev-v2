# Template only: this file is committed to git, so never put real values here.
# Copy it to .env.local (git-ignored) and fill that in. `npm start` reads
# .env.local; on Vercel, set the same values in Project → Settings →
# Environment Variables instead.
# These are used only by the serverless functions in /api and never reach the
# browser.

# The number in your Goodreads profile URL: goodreads.com/user/show/<number>-name
GOODREADS_USER_ID=

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Printed by: npm run spotify-token
SPOTIFY_REFRESH_TOKEN=
